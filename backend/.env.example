# ==============================================================================
# VERIFACT BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your local or production credentials.
# ==============================================================================

# Database Connection (Defaults to SQLite; use PostgreSQL URI in production)
DATABASE_URL=sqlite:///./fractoes.db

# JWT & Authentication Secret
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Multimodal Vision AI Keys (Optional - supports Gemini, Groq, OpenAI, or xAI Grok)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GROK_API_KEY=your_xai_grok_key_here

# Gmail SMTP for Physician Report Dispatch (Optional)
# GMAIL_ADDRESS=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
